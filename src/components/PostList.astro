---
import type { Post } from '../utils/posts';
import FormattedDate from './FormattedDate.astro';

interface Props {
	posts: Post[];
}

const { posts } = Astro.props;
---

{posts.length === 0 && <p class="empty">还没有文章。</p>}
<ul class="post-list">
	{
		posts.map((post) => (
			<li>
				<a class="post-link" href={`/blog/${post.id}/`}>
					<h3>
						{post.data.title}
						{post.data.draft && <span class="draft">草稿</span>}
					</h3>
					<p class="desc">{post.data.description}</p>
				</a>
				<div class="meta">
					<FormattedDate date={post.data.pubDate} />
					{post.data.tags.map((tag) => (
						<a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>
							#{tag}
						</a>
					))}
				</div>
			</li>
		))
	}
</ul>
<style>
	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.post-list li {
		padding: 1.25em 0;
		border-bottom: 1px solid var(--border);
	}
	.post-list li:last-child {
		border-bottom: none;
	}
	.post-link {
		display: block;
		text-decoration: none;
		color: inherit;
	}
	.post-link h3 {
		margin: 0 0 0.3em;
		font-size: 1.2rem;
		color: var(--text-strong);
		transition: color 0.15s;
	}
	.post-link:hover h3 {
		color: var(--accent);
	}
	.desc {
		margin: 0 0 0.5em;
		color: var(--text-muted);
		font-size: 0.95rem;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75em;
		font-size: 0.85rem;
		color: var(--text-muted);
	}
	.tag {
		color: var(--text-muted);
		text-decoration: none;
	}
	.tag:hover {
		color: var(--accent);
	}
	.draft {
		margin-left: 0.5em;
		padding: 0.1em 0.5em;
		border-radius: 4px;
		font-size: 0.7rem;
		vertical-align: middle;
		background: #f59e0b;
		color: #fff;
	}
	.empty {
		color: var(--text-muted);
	}
</style>
