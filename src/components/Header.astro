---
import { SITE_TITLE, SOCIAL_LINKS } from '../consts';
import HeaderLink from './HeaderLink.astro';
import Icon from './Icon.astro';

const links = SOCIAL_LINKS.filter((link) => link.href);
---

<header>
	<nav>
		<a class="site-title" href="/">{SITE_TITLE}</a>
		<div class="internal-links">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/blog/">文章</HeaderLink>
			<HeaderLink href="/tags/">标签</HeaderLink>
			<HeaderLink href="/about/">关于</HeaderLink>
		</div>
		<div class="social-links">
			{
				links.map((link) => (
					<a href={link.href} title={link.label} target={link.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
						<span class="sr-only">{link.label}</span>
						<Icon name={link.icon} />
					</a>
				))
			}
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		padding: 0 1em;
		background: var(--bg-blur);
		backdrop-filter: saturate(180%) blur(12px);
		border-bottom: 1px solid var(--border);
	}
	nav {
		max-width: var(--content-wide);
		margin: 0 auto;
		display: flex;
		align-items: center;
		gap: 1em;
		height: 3.5rem;
	}
	.site-title {
		font-weight: 700;
		font-size: 1.05rem;
		color: var(--text-strong);
		text-decoration: none;
		white-space: nowrap;
		margin-right: auto;
	}
	.internal-links {
		display: flex;
		gap: 0.25em;
	}
	.social-links {
		display: flex;
		gap: 0.5em;
	}
	.social-links a {
		display: flex;
		color: var(--text-muted);
		padding: 0.25em;
	}
	.social-links a:hover {
		color: var(--accent);
	}
	@media (max-width: 640px) {
		nav {
			gap: 0.5em;
		}
		.site-title {
			font-size: 0.95rem;
		}
		.social-links {
			display: none;
		}
	}
</style>
