---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import BaseLayout from './BaseLayout.astro';

type Props = Partial<CollectionEntry<'blog'>['data']> & {
	title: string;
	description: string;
	minutes?: number;
};

const { title, description, pubDate, updatedDate, heroImage, tags = [], minutes } = Astro.props;
---

<BaseLayout title={title} description={description} image={heroImage} narrow>
	<article>
		<header class="post-header">
			<h1>{title}</h1>
			{
				pubDate && (
					<div class="meta">
						<FormattedDate date={pubDate} />
						{updatedDate && (
							<span>
								· 更新于 <FormattedDate date={updatedDate} />
							</span>
						)}
						{minutes && <span>· 约 {minutes} 分钟读完</span>}
					</div>
				)
			}
			{
				tags.length > 0 && (
					<div class="tags">
						{tags.map((tag) => (
							<a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>
						))}
					</div>
				)
			}
		</header>
		{
			heroImage && (
				<div class="hero-image">
					<Image width={1020} height={510} src={heroImage} alt="" />
				</div>
			)
		}
		<div class="prose">
			<slot />
		</div>
	</article>
</BaseLayout>
<style>
	.post-header {
		margin-bottom: 2em;
	}
	.post-header h1 {
		font-size: 2rem;
		margin-bottom: 0.4em;
	}
	.meta {
		color: var(--text-muted);
		font-size: 0.9rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4em;
	}
	.tags {
		margin-top: 0.6em;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
	}
	.tags a {
		font-size: 0.85rem;
		padding: 0.15em 0.6em;
		border-radius: 999px;
		background: var(--surface);
		color: var(--text-muted);
		text-decoration: none;
	}
	.tags a:hover {
		color: var(--accent);
	}
	.hero-image img {
		display: block;
		width: 100%;
		margin-bottom: 2em;
		border-radius: 12px;
	}
</style>
