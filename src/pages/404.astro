---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在" description="你访问的页面不存在">
	<div class="not-found">
		<h1>404</h1>
		<p>你访问的页面不存在，可能已被删除或地址有误。</p>
		<p><a href="/">← 返回首页</a></p>
	</div>
</BaseLayout>
<style>
	.not-found {
		text-align: center;
		padding: 3em 0;
	}
	.not-found h1 {
		font-size: 4rem;
		margin-bottom: 0.2em;
	}
	.not-found p {
		color: var(--text-muted);
	}
</style>
