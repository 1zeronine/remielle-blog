---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, getTags } from '../../utils/posts';

const tags = getTags(await getPosts());
---

<BaseLayout title="标签" description="按标签浏览文章">
	<h1>标签</h1>
	{tags.length === 0 && <p>还没有标签。</p>}
	<ul class="tag-cloud">
		{
			tags.map(({ tag, count }) => (
				<li>
					<a href={`/tags/${encodeURIComponent(tag)}/`}>
						#{tag} <span>{count}</span>
					</a>
				</li>
			))
		}
	</ul>
</BaseLayout>
<style>
	.tag-cloud {
		list-style: none;
		padding: 0;
		margin: 1.5em 0 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.75em;
	}
	.tag-cloud a {
		display: inline-block;
		padding: 0.35em 0.9em;
		border-radius: 999px;
		background: var(--surface);
		color: var(--text);
		text-decoration: none;
	}
	.tag-cloud a:hover {
		color: var(--accent);
	}
	.tag-cloud span {
		color: var(--text-muted);
		font-size: 0.85em;
		margin-left: 0.2em;
	}
</style>
