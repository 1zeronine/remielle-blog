---
import PostList from '../../components/PostList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, getTags, type Post } from '../../utils/posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	return getTags(posts).map(({ tag }) => ({
		params: { tag },
		props: { posts: posts.filter((post) => post.data.tags.includes(tag)) },
	}));
}

const { tag } = Astro.params;
const { posts } = Astro.props as { posts: Post[] };
---

<BaseLayout title={`标签：${tag}`} description={`标签“${tag}”下的 ${posts.length} 篇文章`}>
	<h1>#{tag}</h1>
	<p class="count">共 {posts.length} 篇 · <a href="/tags/">全部标签</a></p>
	<PostList posts={posts} />
</BaseLayout>
<style>
	.count {
		color: var(--text-muted);
	}
</style>
