---
import PostList from '../components/PostList.astro';
import { INTRO, SITE_TITLE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts } from '../utils/posts';

const recent = (await getPosts()).slice(0, 5);
---

<BaseLayout>
	<section class="hero">
		<h1>{SITE_TITLE}</h1>
		<p>{INTRO}</p>
	</section>

	<h2 class="section-title">最新文章</h2>
	<PostList posts={recent} />
	<p class="more"><a href="/blog/">查看全部文章 →</a></p>
</BaseLayout>
<style>
	.hero {
		padding: 1em 0 1.5em;
	}
	.hero h1 {
		font-size: 2.2rem;
		margin-bottom: 0.4em;
	}
	.hero p {
		font-size: 1.1rem;
		color: var(--text-muted);
		max-width: 36em;
	}
	.more {
		margin-top: 1.5em;
	}
</style>
